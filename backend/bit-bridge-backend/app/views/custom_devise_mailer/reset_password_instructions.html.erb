<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #e5e7eb;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background: linear-gradient(140deg, #3f3a3d 0%, #5b5458 55%, #4a4549 100%);
    }

    .frame {
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(7, 10, 20, 0.35);
      background: rgba(17, 24, 39, 0.65);
    }

    .header {
      background: rgba(9, 16, 28, 0.88);
      padding: 20px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .brand {
      display: table;
      width: 100%;
    }

    .brand-logo,
    .brand-copy {
      display: table-cell;
      vertical-align: middle;
    }

    .brand-logo {
      width: 82px;
    }

    .logo {
      max-width: 120px;
      height: 64px;
      display: block;
    }

    .wordmark {
      font-size: 20px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #f8fafc;
      font-weight: 700;
      margin: 0;
      line-height: 1.2;
    }

    .tagline {
      margin: 2px 0 0;
      font-size: 12px;
      color: #9fb5d7;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .content {
      background: rgba(12, 18, 30, 0.72);
      padding: 22px;
    }

    .button {
      display: inline-block;
      padding: 12px 20px;
      background-color: #2f79c8;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      margin: 14px 0;
    }

    .card {
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      padding: 12px;
      margin: 14px 0;
      background: rgba(255, 255, 255, 0.06);
    }

    .footer {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 12px;
      color: #cbd5e1;
      text-align: center;
    }

    .muted {
      color: #cbd5e1;
      font-size: 13px;
    }

    p {
      margin: 10px 0;
    }
  </style>
</head>

<body>
  <div class="frame">
    <div class="header">
      <div class="brand">
        <div class="brand-logo">
          <% if attachments['logo'].present? %>
            <%= image_tag attachments['logo'].url, class: 'logo', alt: 'Bit Bridge Global Logo' %>
          <% end %>
        </div>
        <div class="brand-copy">
          <p class="wordmark">Bit Bridge Global</p>
          <p class="tagline">Secure Financial Infrastructure</p>
        </div>
      </div>
    </div>

    <div class="content">
      <h2 style="margin: 0 0 12px; color: #f8fafc;">Password Reset Request</h2>
      <p>Hello <%= @user&.user_profile&.first_name.presence || @user&.email %>,</p>

      <p>We received a request to reset your Bit Bridge Global account password.</p>

      <div class="card">
        <p><strong>Security notice:</strong> This link expires in <%= distance_of_time_in_words(@reset_password_within) %>.</p>
        <p class="muted">If you did not request this, ignore this email. Your password will remain unchanged.</p>
      </div>

      <p>
        <a href="<%= @reset_password_link %>" class="button">Reset Password</a>
      </p>

      <p class="muted">If the button does not work, copy and paste this URL into your browser:</p>
      <p><%= @reset_password_link %></p>

      <p class="muted">Bit Bridge Global will never ask for your password, PIN, or OTP by email.</p>
    </div>

    <div class="footer">
      <p>&copy; <%= Time.current.year %> Bit Bridge Global. All rights reserved.</p>
      <p><a href="https://www.bitbridgeglobal.com" style="color:#dbeafe;">www.bitbridgeglobal.com</a> | support@bitbridgeglobal.com</p>
    </div>
  </div>
</body>
</html>
