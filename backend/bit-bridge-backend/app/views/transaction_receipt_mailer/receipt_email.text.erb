BitBridge Global <%= @kind_label %> Receipt

Dear <%= @recipient_name %>,

<%= @email_header %>
<%= @email_subheader %>

Reference: <%= @receipt_reference %>
Status: <%= @transaction.status.to_s.upcase %>
Date: <%= @transaction.created_at.strftime('%B %d, %Y %H:%M') %>
Amount: <%= @transaction.amount.to_f %> <%= @transaction.currency || @transaction.wallet&.currency || 'NGN' %>
Type: <%= @kind_label %>
<% if @transaction.address.present? %>
Description: <%= @transaction.address %>
<% end %>

<% if @event_contract.present? %>
Event Classification
--------------------
Schema: <%= @event_contract[:schema_version] %>
Family: <%= @event_contract[:event_family] %>
Phase: <%= @event_contract[:event_phase] %>
Direction: <%= @event_contract[:direction] %>
Provider: <%= @event_contract[:provider] %>
<% if @event_contract[:provider_event_id].present? %>
Provider Event ID: <%= @event_contract[:provider_event_id] %>
<% end %>
<% if @event_contract[:provider_reference].present? %>
Provider Reference: <%= @event_contract[:provider_reference] %>
<% end %>
<% end %>

<% if @balance_snapshot.present? %>
Balance Snapshot
----------------
<% if @balance_snapshot[:before_available].present? %>
Before (Available): <%= @balance_snapshot[:before_available].to_f %> <%= @transaction.currency || @transaction.wallet&.currency || 'NGN' %>
<% end %>
<% if @balance_snapshot[:after_available].present? %>
After (Available): <%= @balance_snapshot[:after_available].to_f %> <%= @transaction.currency || @transaction.wallet&.currency || 'NGN' %>
<% end %>
<% if @balance_snapshot[:before_book].present? %>
Before (Book): <%= @balance_snapshot[:before_book].to_f %> <%= @transaction.currency || @transaction.wallet&.currency || 'NGN' %>
<% end %>
<% if @balance_snapshot[:after_book].present? %>
After (Book): <%= @balance_snapshot[:after_book].to_f %> <%= @transaction.currency || @transaction.wallet&.currency || 'NGN' %>
<% end %>
<% end %>

<% if @anchor_details.present? %>
Bank Transfer Details
---------------------
<% if @anchor_details[:payment_id].present? %>
Provider Payment ID: <%= @anchor_details[:payment_id] %>
<% end %>
<% if @anchor_details[:payment_reference].present? %>
Provider Reference: <%= @anchor_details[:payment_reference] %>
<% end %>
<% if @anchor_details[:paid_at].present? %>
Provider Paid At: <%= @anchor_details[:paid_at] %>
<% end %>
<% if @anchor_details[:narration].present? %>
Narration: <%= @anchor_details[:narration] %>
<% end %>
<% if @anchor_details[:sender_name].present? %>
Sender Name: <%= @anchor_details[:sender_name] %>
<% end %>
<% if @anchor_details[:sender_account_number].present? %>
Sender Account: <%= @anchor_details[:sender_account_number] %>
<% end %>
<% if @anchor_details[:sender_bank_name].present? %>
Sender Bank: <%= @anchor_details[:sender_bank_name] %>
<% end %>
<% if @anchor_details[:beneficiary_account_name].present? %>
Beneficiary Name: <%= @anchor_details[:beneficiary_account_name] %>
<% end %>
<% if @anchor_details[:beneficiary_account_number].present? %>
Beneficiary Account: <%= @anchor_details[:beneficiary_account_number] %>
<% end %>
<% end %>

<% if @fx_quote.present? %>
Conversion Details
------------------
Direction: <%= @fx_quote.direction == 'ngn_to_usd' ? 'NGN to USD' : 'USD to NGN' %>
Amount In: <%= @fx_quote.amount_in.to_f %> <%= @fx_quote.direction == 'ngn_to_usd' ? 'NGN' : 'USD' %>
Fee: <%= @fx_quote.fee_amount.to_f %> <%= @fx_quote.fee_currency %>
Execution Rate: <%= @fx_quote.execution_rate.to_f %>
Amount Out: <%= @fx_quote.amount_out.to_f %> <%= @fx_quote.direction == 'ngn_to_usd' ? 'USD' : 'NGN' %>
<% end %>

