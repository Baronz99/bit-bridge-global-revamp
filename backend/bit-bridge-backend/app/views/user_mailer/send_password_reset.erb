<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #1f2937;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f8fafc;
    }

    .header {
      background-color: #0b1220;
      color: #ffffff;
      padding: 20px;
      text-align: center;
      border-radius: 8px 8px 0 0;
    }

    .logo {
      max-width: 120px;
      height: 80px;
      display: block;
      margin: 0 auto 8px;
    }

    .content {
      background-color: #ffffff;
      border: 1px solid #e5e7eb;
      border-top: none;
      padding: 22px;
    }

    .button {
      display: inline-block;
      padding: 12px 20px;
      background-color: #0b63ce;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      margin: 14px 0;
    }

    .card {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 12px;
      margin: 14px 0;
      background: #f9fafb;
    }

    .footer {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #e5e7eb;
      font-size: 12px;
      color: #6b7280;
      text-align: center;
    }

    .muted {
      color: #6b7280;
      font-size: 13px;
    }
  </style>
</head>

<body>
  <div class="header">
    <% if attachments['logo'].present? %>
      <%= image_tag attachments['logo'].url, class: 'logo', alt: 'BitBridge Global Logo' %>
    <% end %>
    <h1>Password Reset Request</h1>
  </div>

  <div class="content">
    <p>Hello <%= @user&.user_profile&.first_name.presence || @user&.email %>,</p>

    <p>We received a request to reset your BitBridge Global account password.</p>

    <div class="card">
      <p><strong>Security notice:</strong> This link expires in <%= distance_of_time_in_words(@reset_password_within) %>.</p>
      <p class="muted">If you did not request this, ignore this email. Your password will remain unchanged.</p>
    </div>

    <p>
      <a href="<%= @url %>" class="button">Reset Password</a>
    </p>

    <p class="muted">If the button does not work, copy and paste this URL into your browser:</p>
    <p><%= @url %></p>

    <p class="muted">BitBridge Global will never ask for your password, PIN, or OTP by email.</p>
  </div>

  <div class="footer">
    <p>&copy; <%= Time.current.year %> BitBridge Global. All rights reserved.</p>
    <p><a href="https://www.bitbridgeglobal.com">www.bitbridgeglobal.com</a> | support@bitbridgeglobal.com</p>
  </div>
</body>
</html>
